# ──────────────────────────────────────────────────────────────────────────────
# Rasika — environment variables
# Copy to `.env` (never committed). Every key is documented. Values shown are
# the docker-compose local defaults; replace them in staging/production.
# ──────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Public site URL (used for metadata, sitemap, OG image, auth redirects)
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Auth + Postgres) — Phase 2 ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
# Direct Postgres connection for Drizzle migrations / the worker
DATABASE_URL=postgresql://rasika:rasika@localhost:5432/rasika

# ── Redis / BullMQ job queue ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Queue name shared by the web (producer) and the Python worker (consumer)
JOB_QUEUE=rasika:jobs
# Upload limits
MAX_UPLOAD_MB=600
MAX_IMAGE_MB=25

# ── S3-compatible storage (Cloudflare R2 in prod, RustFS locally via docker compose) ──
S3_ENDPOINT=http://localhost:9000
# Endpoint the BROWSER uses for presigned uploads (differs from S3_ENDPOINT inside Docker)
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=rasika
S3_ACCESS_KEY_ID=rasika
S3_SECRET_ACCESS_KEY=rasika-secret
# Set to true for RustFS / path-style buckets; false for R2
S3_FORCE_PATH_STYLE=true

# ── Anthropic (planner + cheap tasks) — Phase 5 ───────────────────────────────
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_PLANNER_MODEL=claude-opus-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
# Worker chain after transcription: plan with Claude (AUTO_PLAN) and render preview + final (AUTO_RENDER)
AUTO_PLAN=true
AUTO_RENDER=true

# ── Payments — Phase 7 (MOCK until then) ─────────────────────────────────────
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_replace-me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email (Resend) — Phase 8 ─────────────────────────────────────────────────
RESEND_API_KEY=re_replace-me
EMAIL_FROM="Rasika <hello@rasika.app>"

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
LOG_LEVEL=info

# ── Worker ───────────────────────────────────────────────────────────────────
# Working directory for per-job scratch (frames, wav, renders)
WORKER_WORK_DIR=./work
# Parallel render chunks (defaults to CPU count)
WORKER_RENDER_PARALLELISM=
# faster-whisper model + device (cpu|cuda) and compute type (int8|float16)
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Where the Whisper model is cached (a docker volume in compose); blank = HF default cache
WHISPER_CACHE_DIR=
# auto (Deepgram when DEEPGRAM_API_KEY is set, else faster-whisper) | deepgram | faster-whisper
TRANSCRIBER=auto
# Deepgram Nova-3: word timestamps, Hindi/English/Hinglish, seconds per reel
DEEPGRAM_API_KEY=
# Script-only reels narrate with Deepgram Aura-2 on the same key (English voices; see docs/costs.md)
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
# Engine harness (dist/rasika-engine.js + harness/index.html) and the TTF fonts; blank = repo paths
ENGINE_DIR=
FONTS_DIR=
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# Optional licensed music bed, mixed only when ENABLE_MUSIC_BED=true and the project asked for music
MUSIC_BED_PATH=
# Seconds a worker may hold a job before it is considered stale
WORKER_JOB_TTL_SEC=3600

# ── Feature flags (Section 9) ────────────────────────────────────────────────
ENABLE_CUTOUT=false
ENABLE_AUTO_IMAGE_FINDER=false
ENABLE_MUSIC_BED=false
ENABLE_HINDI_UI=false

# ── Higgsfield (optional: AI images for landing assets / future image finder) ──
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
