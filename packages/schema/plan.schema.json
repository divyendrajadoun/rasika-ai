{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "plan": {
      "$ref": "#/$defs/Plan"
    },
    "transcript": {
      "$ref": "#/$defs/Transcript"
    },
    "sfxCue": {
      "$ref": "#/$defs/SfxCue"
    }
  },
  "required": [
    "plan",
    "transcript",
    "sfxCue"
  ],
  "$defs": {
    "Plan": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "meta": {
          "$ref": "#/$defs/PlanMeta"
        },
        "style": {
          "$ref": "#/$defs/StyleTokens"
        },
        "subject": {
          "$ref": "#/$defs/Subject"
        },
        "videoModes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/VideoMode"
          }
        },
        "captions": {
          "$ref": "#/$defs/Captions"
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlanElement"
          }
        },
        "sfx": {
          "type": "object",
          "properties": {
            "auto": {
              "default": true,
              "type": "boolean"
            },
            "intensity": {
              "default": 0.8,
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "extra": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SfxCue"
              }
            }
          }
        },
        "endCard": {
          "$ref": "#/$defs/EndCard"
        }
      },
      "required": [
        "version",
        "meta",
        "style",
        "subject",
        "videoModes",
        "captions",
        "elements",
        "sfx"
      ]
    },
    "PlanMeta": {
      "type": "object",
      "properties": {
        "durationSec": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 600
        },
        "fps": {
          "type": "number",
          "const": 30
        },
        "width": {
          "type": "number",
          "const": 1080
        },
        "height": {
          "type": "number",
          "const": 1920
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "description": "'en' | 'hi' | 'hinglish' | BCP-47 tag"
        }
      },
      "required": [
        "durationSec",
        "fps",
        "width",
        "height",
        "language"
      ]
    },
    "StyleTokens": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tagline": {
          "type": "string"
        },
        "palette": {
          "$ref": "#/$defs/Palette"
        },
        "fonts": {
          "type": "object",
          "properties": {
            "poster": {
              "type": "string"
            },
            "accent": {
              "type": "string"
            },
            "ui": {
              "type": "string"
            },
            "devanagari": {
              "type": "string"
            },
            "caption": {
              "type": "string"
            }
          },
          "required": [
            "poster",
            "accent",
            "ui",
            "devanagari",
            "caption"
          ]
        },
        "grain": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pace": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "captionStyle": {
          "type": "string",
          "enum": [
            "one-word",
            "phrase",
            "karaoke",
            "box",
            "clean",
            "off"
          ]
        },
        "captionAccent": {
          "default": "gold",
          "type": "string",
          "enum": [
            "gold",
            "goldd",
            "ter",
            "mar",
            "iv"
          ]
        },
        "captionSize": {
          "type": "integer",
          "minimum": 40,
          "maximum": 140
        },
        "endCardShape": {
          "type": "string",
          "enum": [
            "arch",
            "rounded",
            "square"
          ]
        },
        "pattern": {
          "type": "string",
          "enum": [
            "jaali",
            "arches",
            "bandhani",
            "leheriya",
            "none"
          ]
        },
        "preferredElements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "motion": {
          "default": {},
          "type": "object",
          "properties": {
            "family": {
              "default": "editorial",
              "type": "string",
              "enum": [
                "editorial",
                "kinetic",
                "whiteboard",
                "chalk",
                "hype",
                "launch",
                "collage"
              ]
            },
            "enter": {
              "default": "rise",
              "type": "string",
              "enum": [
                "rise",
                "pop",
                "slam",
                "slide",
                "fade",
                "draw",
                "blur"
              ]
            },
            "exit": {
              "default": "lift",
              "type": "string",
              "enum": [
                "lift",
                "dive",
                "cut",
                "wipe",
                "fade"
              ]
            },
            "easing": {
              "default": "spring",
              "type": "string",
              "enum": [
                "spring",
                "snap",
                "smooth",
                "soft"
              ]
            },
            "speed": {
              "default": 1,
              "type": "number",
              "minimum": 0.5,
              "maximum": 1.6
            },
            "camera": {
              "default": "glide",
              "type": "string",
              "enum": [
                "glide",
                "cut",
                "whip",
                "still"
              ]
            },
            "sfxKit": {
              "default": "pop",
              "type": "string",
              "enum": [
                "pop",
                "click",
                "marker",
                "chalk",
                "hype",
                "cinematic",
                "none"
              ]
            },
            "texture": {
              "default": "none",
              "type": "string",
              "enum": [
                "none",
                "paper",
                "board",
                "grid",
                "dots",
                "vignette",
                "gradient"
              ]
            },
            "direction": {
              "default": "",
              "type": "string",
              "maxLength": 4000
            },
            "avoidElements": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "required": [
        "id",
        "name",
        "tagline",
        "palette",
        "fonts",
        "grain",
        "pace",
        "captionStyle",
        "captionSize",
        "endCardShape",
        "pattern",
        "preferredElements"
      ]
    },
    "Palette": {
      "type": "object",
      "properties": {
        "stage": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "mar": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "ter": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "gold": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "goldd": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "iv": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "ink": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "stage",
        "mar",
        "ter",
        "gold",
        "goldd",
        "iv",
        "ink"
      ]
    },
    "Subject": {
      "type": "object",
      "properties": {
        "faceBox": {
          "$ref": "#/$defs/Rect"
        },
        "freeZone": {
          "description": "where poster type may go — the wall above the head",
          "$ref": "#/$defs/Rect"
        },
        "prop": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "maxLength": 40
            },
            "point": {
              "$ref": "#/$defs/Point"
            }
          },
          "required": [
            "label",
            "point"
          ]
        }
      },
      "required": [
        "faceBox",
        "freeZone"
      ]
    },
    "Rect": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": -4000,
          "maximum": 4000
        },
        "y": {
          "type": "number",
          "minimum": -4000,
          "maximum": 4000
        },
        "w": {
          "type": "number",
          "minimum": 0,
          "maximum": 4000
        },
        "h": {
          "type": "number",
          "minimum": 0,
          "maximum": 4000
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ]
    },
    "Point": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": -4000,
          "maximum": 4000
        },
        "y": {
          "type": "number",
          "minimum": -4000,
          "maximum": 4000
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "VideoMode": {
      "type": "object",
      "properties": {
        "t": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "mode": {
          "$ref": "#/$defs/VideoModeName"
        },
        "zoomPoint": {
          "description": "zoom only — the stage point (px) the punch-in centres on",
          "$ref": "#/$defs/Point"
        },
        "zoomScale": {
          "type": "number",
          "minimum": 1.2,
          "maximum": 3.5
        }
      },
      "required": [
        "t",
        "mode"
      ]
    },
    "VideoModeName": {
      "type": "string",
      "enum": [
        "full",
        "zoom",
        "card",
        "pip",
        "arch"
      ]
    },
    "Captions": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "y": {
          "default": 1400,
          "type": "number",
          "minimum": -4000,
          "maximum": 4000
        },
        "gold": {
          "default": [],
          "description": "emotion / theme words → gold serif italic",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accent": {
          "default": [],
          "description": "nouns, names, numbers → terracotta Anton",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "PlanElement": {
      "oneOf": [
        {
          "$ref": "#/$defs/PosterText"
        },
        {
          "$ref": "#/$defs/Counter"
        },
        {
          "$ref": "#/$defs/LockCard"
        },
        {
          "$ref": "#/$defs/PropPunchIn"
        },
        {
          "$ref": "#/$defs/FeedPhone"
        },
        {
          "$ref": "#/$defs/Stamp"
        },
        {
          "$ref": "#/$defs/ChapterCard"
        },
        {
          "$ref": "#/$defs/ImageCard"
        },
        {
          "$ref": "#/$defs/SplitCards"
        },
        {
          "$ref": "#/$defs/BleedPlate"
        },
        {
          "$ref": "#/$defs/FilmStrip"
        },
        {
          "$ref": "#/$defs/PatternCard"
        },
        {
          "$ref": "#/$defs/Equation"
        },
        {
          "$ref": "#/$defs/Reveal"
        },
        {
          "$ref": "#/$defs/StrikeLine"
        },
        {
          "$ref": "#/$defs/Chips"
        }
      ]
    },
    "PosterText": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "t0": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "t1": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "anchorWordIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "type": {
          "type": "string",
          "const": "posterText"
        },
        "lines": {
          "minItems": 1,
          "maxItems": 4,
          "type": "array",
          "items": {
            "$ref": "#/$defs/TextLine"
          }
        },
        "top": {
          "type": "number",
          "minimum": -4000,
          "maximum": 4000
        },
        "anim": {
          "default": "rise",
          "type": "string",
          "enum": [
            "rise",
            "pop"
          ]
        },
        "left": {
          "type": "number",
          "minimum": -4000,
          "maximum": 4000
        },
        "w": {
          "type": "number",
          "minimum": 100,
          "maximum": 4000
        },
        "align": {
          "type": "string",
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "accent": {
          "description": "sfx hint for this line",
          "type": "string",
          "enum": [
            "glitch",
            "sub"
          ]
        }
      },
      "required": [
        "id",
        "t0",
        "t1",
        "type",
        "lines",
        "top"
      ]
    },
    "TextLine": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "font": {
          "$ref": "#/$defs/TextFont"
        },
        "size": {
          "type": "integer",
          "minimum": 20,
          "maximum": 320
        },
        "color": {
          "description": "omitted → auto by context (light wall vs dark stage)",
          "$ref": "#/$defs/ColorToken"
        },
        "tracking": {
          "description": "letter-spacing in em",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "lineHeight": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 2
        }
      },
      "required": [
        "text",
        "font",
        "size"
      ]
    },
    "TextFont": {
      "type": "string",
      "enum": [
        "anton",
        "serif",
        "kicker",
        "devanagari"
      ]
    },
    "ColorToken": {
      "type": "string",
      "enum": [
        "mar",
        "ter",
        "gold",
        "goldd",
        "iv",
        "stage",
        "ink"
      ]
    },
    "Counter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "t0": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "t1": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "anchorWordIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "type": {
          "type": "string",
          "const": "counter"
        },
        "from": {
          "type": "number"
        },
        "to": {
          "type": "number"
        },
        "label": {
          "type": "string",
          "maxLength": 40
        },
        "top": {
          "default": 215,
          "type": "number",
          "minimum": -4000,
          "maximum": 4000
        },
        "size": {
          "default": 250,
          "type": "integer",
          "minimum": 60,
          "maximum": 320
        },
        "duration": {
          "default": 1,
          "type": "number",
          "minimum": 0.2,
          "maximum": 5
        },
        "color": {
          "$ref": "#/$defs/ColorToken"
        }
      },
      "required": [
        "id",
        "t0",
        "t1",
        "type",
        "from",
        "to",
        "label"
      ]
    },
    "LockCard": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "t0": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "t1": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "anchorWordIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "type": {
          "type": "string",
          "const": "lockCard"
        },
        "word": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "kicker": {
          "default": "THE WORD",
          "type": "string",
          "maxLength": 40
        },
        "sub": {
          "type": "string",
          "maxLength": 40
        },
        "blurred": {
          "default": true,
          "type": "boolean"
        },
        "dark": {
          "default": false,
          "description": "dark variant for the payoff on the stage",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "t0",
        "t1",
        "type",
        "word",
        "sub"
      ]
    },
    "PropPunchIn": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "t0": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "t1": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "anchorWordIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "type": {
          "type": "string",
          "const": "propPunchIn"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "ring": {
          "type": "object",
          "properties": {
            "cx": {
              "type": "number",
              "minimum": -4000,
              "maximum": 4000
            },
            "cy": {
              "type": "number",
              "minimum": -4000,
              "maximum": 4000
            },
            "rx": {
              "type": "number",
              "minimum": 10,
              "maximum": 4000
            },
            "ry": {
              "type": "number",
              "minimum": 10,
              "maximum": 4000
            }
          },
          "required": [
            "cx",
            "cy",
            "rx",
            "ry"
          ]
        },
        "labelTop": {
          "default": 600,
          "type": "number",
          "minimum": -4000,
          "maximum": 4000
        }
      },
      "required": [
        "id",
        "t0",
        "t1",
        "type",
        "label",
        "ring"
      ]
    },
    "FeedPhone": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "t0": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "t1": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "anchorWordIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "type": {
          "type": "string",
          "const": "feedPhone"
        },
        "imageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "posts": {
          "default": 10,
          "type": "integer",
          "minimum": 3,
          "maximum": 14
        },
        "dayFrom": {
          "default": 1,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dayTo": {
          "default": 30,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "postDays": {
          "description": "explicit per-post day labels",
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "handle": {
          "default": "trending.jewels",
          "type": "string",
          "maxLength": 32
        },
        "postCaption": {
          "default": "you saw this again",
          "type": "string",
          "maxLength": 60
        },
        "title": {
          "default": "ON YOUR FEED",
          "type": "string",
          "maxLength": 40
        },
        "dayLabel": {
          "default": "DAY",
          "type": "string",
          "maxLength": 12
        }
      },
      "required": [
        "id",
        "t0",
        "t1",
        "type",
        "imageId"
      ]
    },
    "Stamp": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "t0": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "t1": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "anchorWordIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "type": {
          "type": "string",
          "const": "stamp"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        }
      },
      "required": [
        "id",
        "t0",
        "t1",
        "type",
        "text"
      ]
    },
    "ChapterCard": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "t0": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "t1": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "anchorWordIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "type": {
          "type": "string",
          "const": "chapterCard"
        },
        "number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4
        },
        "line": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "italicLine": {
          "type": "string",
          "maxLength": 60
        }
      },
      "required": [
        "id",
        "t0",
        "t1",
        "type",
        "number",
        "line",
        "italicLine"
