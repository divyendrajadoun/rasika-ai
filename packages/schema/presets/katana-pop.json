{
  "id": "katana-pop",
  "name": "Katana Pop",
  "tagline": "Pink paper, cobalt ink, comic type and a yellow highlighter.",
  "palette": {
    "stage": "#2B0303",
    "mar": "#2A5CC4",
    "ter": "#D02A2A",
    "gold": "#F5C518",
    "goldd": "#b88d00",
    "iv": "#ffd9e4",
    "ink": "#160a0a"
  },
  "fonts": {
    "poster": "Bangers",
    "accent": "Caveat",
    "ui": "Inter",
    "devanagari": "Tiro Devanagari Hindi",
    "caption": "Montserrat"
  },
  "grain": 0.03,
  "pace": 0.75,
  "captionStyle": "box",
  "captionSize": 80,
  "captionAccent": "gold",
  "endCardShape": "rounded",
  "pattern": "none",
  "preferredElements": [
    "posterText",
    "chips",
    "stamp",
    "imageCard",
    "strikeLine"
  ],
  "motion": {
    "family": "hype",
    "enter": "slam",
    "exit": "cut",
    "easing": "snap",
    "speed": 1.0,
    "camera": "whip",
    "sfxKit": "hype",
    "texture": "none",
    "direction": "Loud and fast. One or two giant words slam in on the first word; a punch-in (`zoom`) every 3–4 s on the thing being named; `stamp` verdicts on judgement words; `chips` for lists; something changes every 1.5–2.5 s. Hard cuts, no fades, no soft serif lines.",
    "avoidElements": [
      "filmStrip",
      "bleedPlate"
    ]
  }
}
