{
  "id": "bold-creator",
  "name": "Bold Creator",
  "tagline": "High energy. Big karaoke captions, more punch-ins, faster cuts.",
  "palette": {
    "stage": "#101010",
    "mar": "#121212",
    "ter": "#ff3d3d",
    "gold": "#ffd300",
    "goldd": "#c79a00",
    "iv": "#ffffff",
    "ink": "#000000"
  },
  "fonts": {
    "poster": "Montserrat",
    "accent": "Instrument Serif",
    "ui": "Inter",
    "devanagari": "Tiro Devanagari Hindi",
