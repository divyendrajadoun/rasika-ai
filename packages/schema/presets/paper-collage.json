{
  "id": "paper-collage",
  "name": "Paper Collage",
  "tagline": "Kraft paper, marker type, red tape. The Vox-style explainer feel.",
  "palette": {
    "stage": "#e8dcc3",
    "mar": "#2b2520",
    "ter": "#d7263d",
    "gold": "#2b2520",
    "goldd": "#8c4a1f",
    "iv": "#fbf6ec",
    "ink": "#2b2520"
  },
  "fonts": {
    "poster": "Archivo Black",
    "accent": "Caveat",
    "ui": "Inter",
    "devanagari": "Tiro Devanagari Hindi",
    "caption": "Inter"
  },
  "grain": 0.1,
  "pace": 0.55,
  "captionStyle": "box",
  "captionSize": 70,
  "captionAccent": "ter",
  "endCardShape": "square",
  "pattern": "none",
  "preferredElements": [
    "posterText",
    "imageCard",
    "splitCards",
    "chips",
    "equation",
    "patternCard"
  ],
  "motion": {
    "family": "collage",
    "enter": "pop",
    "exit": "wipe",
    "easing": "spring",
    "speed": 1.0,
    "camera": "still",
    "sfxKit": "marker",
    "texture": "paper",
    "direction": "Paper collage explainer. Taped photo cards (tilt ±4–8), marker notes in the accent hand, `patternCard`s as coloured paper, `equation`s and `strikeLine`s drawn like a Vox explainer, `chips` as labels. Ideas wipe away between beats. No film strips, no feed phone.",
    "avoidElements": [
      "filmStrip",
      "feedPhone",
      "bleedPlate"
    ]
  }
}
