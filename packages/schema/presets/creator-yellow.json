{
  "id": "creator-yellow",
  "name": "Creator Yellow",
  "tagline": "The podcast-clip look: black stage, white caps, one yellow word lit at a time.",
  "palette": {
    "stage": "#000000",
    "mar": "#0d0d0d",
    "ter": "#7cf5c4",
    "gold": "#ffd300",
    "goldd": "#b89600",
    "iv": "#ffffff",
    "ink": "#000000"
  },
  "fonts": {
    "poster": "Montserrat",
    "accent": "Instrument Serif",
    "ui": "Inter",
    "devanagari": "Tiro Devanagari Hindi",
    "caption": "Montserrat"
  },
  "grain": 0,
  "pace": 0.85,
  "captionStyle": "karaoke",
  "captionSize": 96,
  "captionAccent": "gold",
  "endCardShape": "rounded",
  "pattern": "none",
  "preferredElements": [
    "posterText",
    "counter",
    "chips",
    "chapterCard",
    "stamp"
  ],
  "motion": {
    "family": "hype",
    "enter": "slam",
    "exit": "cut",
    "easing": "snap",
    "speed": 1.0,
    "camera": "whip",
    "sfxKit": "hype",
    "texture": "none",
    "direction": "Yellow-on-black retention cut. Slams, stamps, zoom punch-ins every 3–4 s, boxed captions carry the words so poster lines are short (1–3 words). `feedPhone` when scrolling is mentioned. Nothing holds longer than 3 s.",
    "avoidElements": [
      "filmStrip",
      "bleedPlate",
      "patternCard"
    ]
  }
}
