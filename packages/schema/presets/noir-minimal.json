{
  "id": "noir-minimal",
  "name": "Noir Minimal",
  "tagline": "Black, white and one accent. Slow, calm, founder-friendly.",
  "palette": {
    "stage": "#0b0b0c",
    "mar": "#111111",
    "ter": "#e63946",
    "gold": "#f1f1f1",
    "goldd": "#333333",
    "iv": "#f7f7f7",
    "ink": "#000000"
  },
  "fonts": {
    "poster": "Inter",
    "accent": "Instrument Serif",
    "ui": "Inter",
    "devanagari": "Tiro Devanagari Hindi",
    "caption": "Inter"
  },
  "grain": 0,
  "pace": 0.3,
  "captionStyle": "clean",
  "captionSize": 64,
  "captionAccent": "gold",
  "endCardShape": "square",
  "pattern": "none",
  "preferredElements": [
    "posterText",
    "counter",
    "equation",
    "chapterCard"
  ],
  "motion": {
    "family": "kinetic",
    "enter": "blur",
    "exit": "dive",
    "easing": "soft",
    "speed": 1.1,
    "camera": "cut",
    "sfxKit": "click",
    "texture": "vignette",
    "direction": "Typography only, centred, mixed case, one thought per card, 1–2 s holds, blur-ins, hard cuts between ideas. White on near-black; a single accent word per line at most. Numbers as counters. No tilted cards, no stamps, no patterns.",
    "avoidElements": [
      "stamp",
      "patternCard",
      "bleedPlate",
      "filmStrip",
      "feedPhone",
      "splitCards"
    ]
  }
}
