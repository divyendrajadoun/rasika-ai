{
  "id": "clinic-clean",
  "name": "Clinic Clean",
  "tagline": "Calm white and navy for doctors, dentists and advisors. Boxed captions, no stamps.",
  "palette": {
    "stage": "#eef3f7",
    "mar": "#12345a",
    "ter": "#1f8a8a",
    "gold": "#12345a",
    "goldd": "#1f8a8a",
    "iv": "#ffffff",
    "ink": "#0b1d33"
  },
  "fonts": {
    "poster": "Poppins",
    "accent": "Instrument Serif",
    "ui": "Poppins",
    "devanagari": "Tiro Devanagari Hindi",
    "caption": "Poppins"
  },
  "grain": 0,
  "pace": 0.45,
  "captionStyle": "box",
  "captionSize": 72,
  "captionAccent": "ter",
  "endCardShape": "rounded",
  "pattern": "none",
  "preferredElements": [
    "posterText",
    "counter",
    "chapterCard",
    "equation",
    "imageCard"
  ],
  "motion": {
    "family": "launch",
    "enter": "slide",
    "exit": "fade",
    "easing": "smooth",
    "speed": 1.0,
    "camera": "glide",
    "sfxKit": "click",
    "texture": "none",
    "direction": "Clinical clarity. Short mixed-case lines slide in from the left, `chapterCard`s for the steps, `equation`s for cause → effect, `counter`s for doses and days, straight image cards. One idea per beat, 2–3 s holds, calm camera.",
    "avoidElements": [
      "stamp",
      "filmStrip",
      "patternCard",
      "feedPhone"
    ]
  }
}
