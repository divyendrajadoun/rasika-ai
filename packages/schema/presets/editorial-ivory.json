{
  "id": "editorial-ivory",
  "name": "Editorial Ivory",
  "tagline": "Magazine white. Serif display, one red accent, captions as a clean lower third.",
  "palette": {
    "stage": "#efe9df",
    "mar": "#1c1b19",
    "ter": "#c0392b",
    "gold": "#1c1b19",
    "goldd": "#7a3b2e",
    "iv": "#faf7f2",
    "ink": "#1c1b19"
  },
  "fonts": {
    "poster": "DM Serif Display",
    "accent": "Playfair Display",
    "ui": "Inter",
    "devanagari": "Tiro Devanagari Hindi",
    "caption": "Inter"
  },
  "grain": 0.02,
  "pace": 0.4,
  "captionStyle": "clean",
  "captionSize": 62,
  "captionAccent": "ter",
  "endCardShape": "square",
  "pattern": "none",
  "preferredElements": [
    "posterText",
    "equation",
    "imageCard",
    "bleedPlate",
    "filmStrip"
  ],
  "motion": {
    "family": "kinetic",
    "enter": "fade",
    "exit": "fade",
    "easing": "soft",
    "speed": 1.3,
    "camera": "still",
    "sfxKit": "cinematic",
    "texture": "gradient",
    "direction": "Quiet luxury. Fewer, longer beats (3–5 s), serif italic lines fading in, mixed case, generous space, straight photo cards (`tilt` 0–1) that rest, a counter only when a number matters. No stamps, no slams, no pattern cards.",
    "avoidElements": [
      "stamp",
      "patternCard",
      "feedPhone",
      "chips"
    ]
  }
}
