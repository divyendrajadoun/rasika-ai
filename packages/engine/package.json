{
  "name": "@rasika/engine",
  "version": "0.1.0",
  "private": true,
  "description": "Rasika motion engine — plan JSON → frames. Zero runtime deps; runs in the browser (preview) and headless (render).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "esbuild src/harness.ts --bundle --format=iife --global-name=RasikaEngine --target=es2020 --outfile=dist/rasika-engine.js --minify --log-level=warning && tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0",
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "@rasika/schema": "workspace:*"
  }
}
