{
  "name": "rasika",
  "private": true,
  "version": "0.1.0",
  "description": "Rasika — AI motion-designed reel editor (SaaS monorepo)",
  "packageManager": "pnpm@10.3.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "worker:dev": "cd apps/worker && python -m rasika_worker.main",
    "worker:check": "cd apps/worker && ruff check . && ruff format --check . && mypy rasika_worker && pytest -q",
    "schema:export": "pnpm --filter @rasika/schema export",
    "schema:pydantic": "python tools/gen_plan_models.py",
    "golden": "python tools/golden/golden.py",
    "validate:plan": "pnpm --filter @rasika/schema validate"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "turbo": "^2.11.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8"
  }
}
